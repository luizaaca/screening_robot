SCREENING_AGENT_PATIENT_DB_PATH=data/patients.sqlite3

# Supported control backends: mock | openai | openrouter | openai_compatible
SCREENING_AGENT_CONTROL_BACKEND=mock
SCREENING_AGENT_CONTROL_MODEL=gpt-4.1-mini
# Used only when SCREENING_AGENT_CONTROL_BACKEND=openai_compatible
SCREENING_AGENT_CONTROL_BASE_URL=http://localhost:1234/v1
SCREENING_AGENT_CONTROL_API_KEY=change-me
SCREENING_AGENT_CONTROL_TEMPERATURE=0.0

# Supported clinical backends: mock | openai | openrouter | openai_compatible | gguf
SCREENING_AGENT_CLINICAL_BACKEND=mock
SCREENING_AGENT_CLINICAL_MODEL=gpt-4.1-mini
# Used only when SCREENING_AGENT_CLINICAL_BACKEND=openai_compatible
SCREENING_AGENT_CLINICAL_BASE_URL=http://localhost:1234/v1
SCREENING_AGENT_CLINICAL_API_KEY=change-me
SCREENING_AGENT_CLINICAL_TEMPERATURE=0.0

# Supported video analyst backends: mock | openai | openrouter | openai_compatible
SCREENING_AGENT_VIDEO_ANALYST_BACKEND=mock
SCREENING_AGENT_VIDEO_ANALYST_MODEL=gpt-4.1-mini
# Used only when SCREENING_AGENT_VIDEO_ANALYST_BACKEND=openai_compatible
SCREENING_AGENT_VIDEO_ANALYST_BASE_URL=http://localhost:1234/v1
SCREENING_AGENT_VIDEO_ANALYST_API_KEY=change-me
SCREENING_AGENT_VIDEO_ANALYST_TEMPERATURE=0.0

SCREENING_AGENT_VIDEO_PIPELINE_OUTPUT_DIR=outputs/videos
SCREENING_AGENT_VIDEO_PIPELINE_DEBUG=false
SCREENING_AGENT_VIDEO_UPLOAD_MAX_MB=100
SCREENING_AGENT_VIDEO_PIPELINE_WINDOW_S=8.0
SCREENING_AGENT_VIDEO_PIPELINE_STRIDE_S=5.0

SCREENING_AGENT_GGUF_MODEL_PATH=models/screening_robot.gguf
# Keep enabled for the Chainlit streaming UI, which reads the final turn state from checkpoints.
SCREENING_AGENT_USE_IN_MEMORY_CHECKPOINTER=true
SCREENING_AGENT_CONSOLE_DEBUG_MODE=none

# Examples:
# SCREENING_AGENT_CONTROL_BACKEND=openai
# SCREENING_AGENT_CONTROL_MODEL=gpt-4.1-mini
# SCREENING_AGENT_CLINICAL_BACKEND=openrouter
# SCREENING_AGENT_CLINICAL_MODEL=openai/gpt-4.1-mini
# SCREENING_AGENT_CONTROL_BACKEND=openai_compatible
# SCREENING_AGENT_CONTROL_BASE_URL=http://localhost:1234/v1
# SCREENING_AGENT_CONSOLE_DEBUG_MODE=info
# SCREENING_AGENT_CONSOLE_DEBUG_MODE=debug
